{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commerce-engineering-lab.invalid/schemas/task-manifest-v1.json",
  "title": "Commerce Engineering Lab task manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "type",
    "difficulty",
    "estimatedMinutes",
    "prerequisites",
    "baselineBranch",
    "scenarioSeed",
    "affectedApi",
    "requiredServices",
    "reproduceCommand",
    "visibleVerificationCommand",
    "hiddenVerificationCommand",
    "resetCommand",
    "compatibilityConstraints",
    "learningObjectives"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^TRN-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "type": {
      "enum": ["bug", "feature", "investigation", "database-change", "integration", "operational-audit"]
    },
    "difficulty": { "enum": ["beginner", "intermediate", "advanced"] },
    "estimatedMinutes": { "type": "integer", "minimum": 15, "maximum": 960 },
    "prerequisites": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "baselineBranch": { "type": "string", "pattern": "^task/TRN-[0-9]{3}-baseline$" },
    "scenarioSeed": { "type": "string", "pattern": "^TRN-[0-9]{3}$" },
    "affectedApi": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "requiredServices": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "reproduceCommand": { "type": "string", "minLength": 1 },
    "visibleVerificationCommand": { "type": "string", "minLength": 1 },
    "hiddenVerificationCommand": { "type": "string", "pattern": "^mentor-verify TRN-[0-9]{3}$" },
    "resetCommand": { "type": "string", "minLength": 1 },
    "compatibilityConstraints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "learningObjectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
